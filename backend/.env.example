# Copy this file to .env and fill in real values before running in production.
# Every value here has a safe default in app/core/config.py for local dev,
# so the app runs out of the box with NO .env file at all - .env only
# overrides what you need to change.

# --- App ---
APP_NAME=DoSJE Nigrani API
ENV=development
DEBUG=true

# --- Database ---
# Local dev / tests: sqlite (default, zero setup)
# Docker / production: postgresql://dosje:dosje_dev@db:5432/dosje
DATABASE_URL=sqlite:///./dosje_nigrani.db

# --- Auth ---
# Generate a real secret for production: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS ---
# "*" allows any frontend origin (fine for local dev). Once you have a
# real deployed frontend URL, set this explicitly, comma-separated if
# more than one, e.g.:
# CORS_ORIGINS=https://your-dashboard.onrender.com,http://localhost:5173
CORS_ORIGINS=*

# --- Rate limiting ---
LOGIN_RATE_LIMIT=5/minute

# --- Object storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./evidence_store
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=evidence-bucket

# --- Assignment engine ---
FAIRNESS_WINDOW=5
GEOFENCE_RADIUS_METERS=500.0

# --- VC calls ---
VC_PICKUP_WINDOW_SECONDS=120
